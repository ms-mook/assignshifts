# รหัสผ่านเข้าเว็บ (ผู้จัดตารางคนเดียว)
APP_PASSWORD=
# สุ่มข้อความยาว ≥ 32 ตัวอักษร ใช้เซ็น cookie
SESSION_SECRET=

# Google Service Account (ต้องแชร์ Google Sheet ทั้ง 4 ไฟล์ให้อีเมลนี้เป็น "ผู้แก้ไข")
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# แบบที่ 1 — ไม่ใช้ key (Vercel OIDC + Workload Identity Federation)
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# แบบที่ 2 — ใช้ key JSON (ถ้าองค์กรอนุญาตให้สร้าง key) วาง private key ทั้งก้อน (บรรทัดใหม่ใช้ \n ได้)
# GOOGLE_PRIVATE_KEY=

# (ไม่บังคับ) เปลี่ยน ID ชีต — ค่าเริ่มต้นตั้งไว้แล้วใน src/lib/config.ts
# SHEET_ID_SHIFT3=
# SHEET_ID_KEY=
# SHEET_ID_SMC=
# SHEET_ID_OT=
